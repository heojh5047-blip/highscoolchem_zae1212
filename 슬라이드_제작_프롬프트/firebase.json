{
  "hosting": {
    "public": "차시자료",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "_소스/**", "vendor/**", "app/**"],
    "headers": [
      { "source": "**/*.@(html|json|js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "database": { "rules": "database.rules.json" }
}
